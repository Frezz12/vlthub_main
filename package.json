{
  "name": "VLTHub",
  "private": true,
  "version": "0.2.0",
  "description": "VLTHub",
  "scripts": {
    "dev": "pnpm --filter @pjasaver/desktop dev",
    "dev:backend": "cd apps/backend && uvicorn app.main:app --reload --port 8000",
    "dev:infra": "docker compose up -d postgres redis",
    "build": "pnpm --filter @pjasaver/desktop build",
    "tauri:dev": "pnpm --filter @pjasaver/desktop tauri:dev",
    "tauri:build": "pnpm --filter @pjasaver/desktop tauri:build",
    "backend:install": "cd apps/backend && pip install -e .",
    "db:migrate": "cd apps/backend && alembic upgrade head",
    "db:revision": "cd apps/backend && alembic revision --autogenerate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
